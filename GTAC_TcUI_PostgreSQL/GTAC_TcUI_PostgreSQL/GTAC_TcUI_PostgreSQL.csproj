<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyName>GTAC_TcUI_PostgreSQL</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<Company>Sodecia GTAC</Company>
		<Description>TcHmi Server Extension for interacting with PostgreSQL Database</Description>
		<Copyright>Copyright © 2022-2026 Brent Lekx-Toniolo, Chris Drees (test)</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiExtensionTypes>{165402F8-2FAD-480A-BCE3-D718A6135931}</TcHmiExtensionTypes>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiServerApiVersionNumberMajor>1</TcHmiServerApiVersionNumberMajor>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiInstallDir>$(registry:HKEY_CURRENT_USER\Software\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiInstallDir Condition="'$(TcHmiInstallDir)'==''">$(registry:HKEY_LOCAL_MACHINE\Software\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiInstallDir Condition="'$(TcHmiInstallDir)'==''">$(registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiEgineeringDir>$(TcHmiInstallDir)..\Functions\TE2000-HMI-Engineering</TcHmiEgineeringDir>
		<TcHmiMsBuildPath Condition="'$(TcHmiMsBuildPath)' == ''">$(TcHmiEgineeringDir)\MSBuild\</TcHmiMsBuildPath>
	</PropertyGroup>

	<Import Project="$(TWINCAT3DIR)..\Functions\TE2000-HMI-Engineering\Infrastructure\TcHmiServer\imports\TcHmiServerExtensionCSharp.proj" />

	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);___initialBuild_of_this_extension.tmp</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup>
		<ProjectGuid>a4eb6faa-95b3-4040-ae2f-922fa9c4eed1</ProjectGuid>
		<Version>1.12.762.5313</Version>
		<PackageIcon></PackageIcon>
		<AssemblyVersion>1.12.762.5313</AssemblyVersion>
		<FileVersion>1.12.762.5313</FileVersion>
		<PackageReleaseNotes>Rebuild in VS Studio 2026 and upgrade NPGSQL to latest 9 series release</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Authors>Brent Lekx-Toniolo, Chris Drees (test)</Authors>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/Sodecia-GTAC/TcUI-Extensions</PackageProjectUrl>
		<PackageTags>TwinCAT HMI Server, TcHmi, TcUI, PostgreSQL, Database, GTAC</PackageTags>
		<ApplicationIcon>logo.ico</ApplicationIcon>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <!-- Dependancies -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- NuGet Pack Layout (Tchmi is picky about the expected layout and doesnt follow all newer SDK styled NuGet layout practices) -->
  <ItemGroup>
    <!-- DLLs to go under runtimes/any/native -->
    <None Include="$(OutputPath)\GTAC_TcUI_PostgreSQL.dll" Pack="true" PackagePath="runtimes/any/native/" />
    <None Include="$(OutputPath)\Npgsql.dll" Pack="true" PackagePath="runtimes/any/native/" />
    <None Include="$(OutputPath)\Microsoft.Extensions.Logging.Abstractions.dll" Pack="true" PackagePath="runtimes/any/native/" />

    <!-- JSON files to go under runtimes/any/native -->
    <None Include="$(OutputPath)\GTAC_TcUI_PostgreSQL.Config.json" Pack="true" PackagePath="runtimes/any/native/" />
    <None Include="$(OutputPath)\GTAC_TcUI_PostgreSQL.deps.json" Pack="true" PackagePath="runtimes/any/native/" />
    <None Include="$(OutputPath)\GTAC_TcUI_PostgreSQL.Language.en.json" Pack="true" PackagePath="runtimes/any/native/" />
    <None Include="$(OutputPath)\GTAC_TcUI_PostgreSQL.Schema.json" Pack="true" PackagePath="runtimes/any/native/" />

    <!-- Image files to go under images/-->
    <None Include="images\*.png" Pack="true" PackagePath="images/" />
    <None Include="images\*.ico" Pack="true" PackagePath="images/" />

    <!-- License file at package root -->
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />


  </ItemGroup>


</Project>